# ==============================================================================
# MEDISCAN NFC HOSPITAL — SENDER EMAIL & PHONE CONFIGURATION
# ==============================================================================

# Hospital / Sender Identity
HOSPITAL_NAME="MediScan NFC Hospital"
HOSPITAL_PHONE="+1 (555) 234-5678"

# ── GMAIL SENDER CONFIGURATION ────────────────────────────────────────────────
# Use your Gmail address and a 16-character Google App Password:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" / "MediScan Hospital"
# 4. Paste the 16-character code below (no spaces or with spaces):
GMAIL_USER=yourhospital@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# ── ALTERNATIVE: CUSTOM SMTP (SendGrid, Mailgun, AWS SES, Outlook) ─────────────
# Leave empty if using Gmail above:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Server Port
PORT=3000

# ── SUPABASE / POSTGRESQL DATABASE (Required for Vercel persistence) ────────────
# Note: Use the IPv4 Connection Pooler (port 6543) so Vercel serverless can connect:
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres


